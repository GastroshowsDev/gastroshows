# Database & Authentication
DATABASE_URL="postgresql://user:password@localhost:5432/gastroshows"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Supabase (if using)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxx"

# Site Configuration
NEXT_PUBLIC_SITE_URL="https://gastroshows.es"
NEXT_PUBLIC_SITE_NAME="GastroShows"

# Tracking & Analytics - Google
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Tracking & Analytics - Meta (Facebook)
NEXT_PUBLIC_META_PIXEL_ID="XXXXXXXXXX"

# Tracking & Analytics - TikTok
NEXT_PUBLIC_TIKTOK_PIXEL_ID="XXXXXXXXXX"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@gastroshows.es"

# Payment Processing (if applicable)
STRIPE_SECRET_KEY="sk_live_xxxxx"
STRIPE_PUBLISHABLE_KEY="pk_live_xxxxx"

# API Keys
OPENAI_API_KEY="sk-xxxxx"

# Feature Flags
NODE_ENV="development"
NEXT_PUBLIC_ENVIRONMENT="development"
