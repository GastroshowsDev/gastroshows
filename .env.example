# Runtime (Prisma 7 + adapter `pg`): usa pooler o conexion directa según tu despliegue.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migraciones: en local suele usarse URL directa (sin pooler) como DATABASE_URL al ejecutar `prisma migrate`.
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# NextAuth (fase posterior)
NEXTAUTH_URL="https://gastroshows.vercel.app/"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Admin credentials (fase posterior)
ADMIN_EMAIL="tech@gastroshows.es"
ADMIN_PASSWORD_HASH=""

# Mailrelay — email marketing
# API key: Mailrelay → Configuración → Integraciones → API
MAILRELAY_API_KEY=""
# URL base de tu cuenta (e.g. https://micuenta.ipzmarketing.com)
MAILRELAY_BASE_URL=""
# ID numérico del grupo/lista de suscriptores en Mailrelay
MAILRELAY_GROUP_ID=""

# Cron security (fase posterior)
CRON_SECRET=""

# Redsys TPV Virtual
# Datos del back-office de Redsys (entorno de pruebas o producción)
REDSYS_MERCHANT_CODE=""          # Código FUC (9 dígitos)
REDSYS_TERMINAL=""               # Número de terminal, normalmente "001"
REDSYS_SECRET_KEY=""             # Clave SHA256 (base64) del back-office Redsys
# Test:       https://sis-t.redsys.es:25443/sis/realizarPago
# Producción: https://sis.redsys.es/sis/realizarPago
REDSYS_URL=""
# URLs de retorno al cliente tras el pago
REDSYS_URLOK="https://gastroshows.es/api/payments/return"
REDSYS_URLKO="https://gastroshows.es/api/payments/return"
# URL de notificación server-to-server (debe ser pública, sin autenticación)
REDSYS_NOTIFICATION_URL="https://gastroshows.es/api/payments/callback"
