generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id            String        @id @default(cuid())
  name          String
  phone         String
  email         String        @unique
  customerType  CustomerType  @default(PARTICULAR)
  cif           String?
  billingStreet String?
  billingZip    String?
  billingCity   String?
  allergies     String?
  previousVisit Boolean       @default(false)
  newsletter    Boolean       @default(false)
  source        String?
  comments      String?
  createdAt     DateTime      @default(now())
  giftVouchers  GiftVoucher[] @relation("VoucherPurchaser")
  reservations  Reservation[]

  @@index([email])
  @@index([createdAt])
  @@index([customerType])
}

model Venue {
  id             String          @id @default(cuid())
  name           String          @unique
  capacity       Int
  rules          Json
  emailTemplates EmailTemplate[]
  events         Event[]
  reservations   Reservation[]
  spaces         Space[]
}

model Event {
  id           String        @id @default(cuid())
  date         DateTime
  shift        Shift
  venueId      String?
  totalGuests  Int           @default(0)
  status       EventStatus   @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  venue        Venue?        @relation(fields: [venueId], references: [id])
  reservations Reservation[]

  @@unique([date, shift])
  @@index([venueId])
  @@index([status, date])
}

model Reservation {
  id            String            @id @default(cuid())
  type          ReservationType
  customerId    String
  eventId       String?
  venueId       String?
  guests        Int
  totalAmount   Decimal           @db.Decimal(10, 2)
  paidAmount    Decimal           @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus     @default(PARTIAL)
  status        ReservationStatus @default(PENDING)
  groupRef      String?
  mergedGroupId String?
  isFirstVisit  Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  visitDate     DateTime?
  visitTime     String?
  emailQueue    EmailQueue[]
  giftVoucher   GiftVoucher?
  paymentSplits PaymentSplit[]
  customer      Customer          @relation(fields: [customerId], references: [id])
  event         Event?            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  venue         Venue?            @relation(fields: [venueId], references: [id])
  tableAssignments TableAssignment[]
  workflowExecutions WorkflowExecution[]
  source        String?
  comments      String?
  turitopId     String?           @unique

  @@index([eventId, status])
  @@index([venueId, createdAt])
  @@index([groupRef])
  @@index([mergedGroupId])
  @@index([visitDate])
}

model GiftVoucher {
  id                  String       @id @default(cuid())
  token               String       @unique @default(uuid())
  purchaserCustomerId String
  recipientEmail      String?
  guests              Int
  totalAmount         Decimal      @db.Decimal(10, 2)
  expiresAt           DateTime
  redeemedAt          DateTime?
  reservationId       String?      @unique
  createdAt           DateTime     @default(now())
  emailSent           Boolean      @default(false)
  sendDate            DateTime?
  purchaser           Customer     @relation("VoucherPurchaser", fields: [purchaserCustomerId], references: [id])
  reservation         Reservation? @relation(fields: [reservationId], references: [id])

  @@index([expiresAt])
  @@index([redeemedAt])
}

model PaymentSplit {
  id            String        @id @default(cuid())
  reservationId String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  paidAt        DateTime      @default(now())
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, paidAt])
}

model EmailQueue {
  id            String           @id @default(cuid())
  reservationId String
  templateKey   String
  scheduledAt   DateTime
  sentAt        DateTime?
  status        EmailQueueStatus @default(PENDING)
  attempts      Int              @default(0)
  createdAt     DateTime         @default(now())
  reservation   Reservation      @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([reservationId, status])
}

model EmailTemplate {
  id          String   @id @default(cuid())
  venueId     String?
  templateKey String   @unique
  htmlContent String
  subject     String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  venue       Venue?   @relation(fields: [venueId], references: [id])

  @@index([venueId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(LIVE)
  defaultVenue String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(uuid())
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
}

model Backup {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  triggeredBy String
  status      BackupStatus @default(RUNNING)
  sizeBytes   Int?
  rowCount    Int?
  data        Json?
  error       String?

  @@index([createdAt])
}

model SeoSettings {
  id                     String   @id @default("default")
  siteTitle              String   @default("GastroShows · Barcelona")
  metaDescription        String?
  metaKeywords           String?
  ogTitle                String?
  ogDescription          String?
  ogImage                String?
  twitterCard            String   @default("summary_large_image")
  twitterHandle          String?
  canonicalUrl           String?
  robots                 String   @default("index, follow")
  googleSiteVerification String?
  bingSiteVerification   String?
  googleAnalyticsId      String?
  googleTagManagerId     String?
  metaPixelId            String?
  tiktokPixelId          String?
  linkedinPartnerId      String?
  hotjarId               String?
  googleAdsId            String?
  googleAdsLabel         String?
  customHeadScripts      String?
  customBodyScripts      String?
  schemaOrg              String?
  updatedAt              DateTime @updatedAt
}

model LandingContent {
  key       String   @id
  value     String
  type      String   @default("TEXT")
  label     String
  section   String
  order     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([section, order])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  discountPct Decimal  @db.Decimal(5, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, startDate, endDate])
}

model Workflow {
  id          String              @id @default(cuid())
  name        String
  trigger     String              // Ej: "RESERVATION_CONFIRMED", "VISIT_REQUESTED"
  description String?
  active      Boolean             @default(true)
  steps       Json                // Array de { type: "email" | "wait", delayDays?: number, templateKey?: string }
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  executions  WorkflowExecution[]
}

model WorkflowExecution {
  id            String      @id @default(cuid())
  workflowId    String
  reservationId String
  currentStep   Int         @default(0)
  status        String      @default("RUNNING") // RUNNING, COMPLETED, CANCELLED
  nextStepAt    DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  workflow      Workflow    @relation(fields: [workflowId], references: [id])
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([status, nextStepAt])
  @@index([reservationId])
}

model Page {
  id        String      @id @default(cuid())
  title     String
  slug      String      @unique
  published Boolean     @default(false)
  seoTitle  String?
  seoDesc   String?
  ogImage   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  blocks    PageBlock[]
}

model PageBlock {
  id        String   @id @default(cuid())
  pageId    String
  type      String
  content   Json     @default("{}")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
}

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  url         String
  storagePath String
  mimeType    String
  sizeBytes   Int
  alt         String   @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())

  @@index([fromPath])
}

model Employee {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  pin       String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  timeLogs  TimeLog[]

  @@index([pin])
}

model TimeLog {
  id             String    @id @default(cuid())
  employeeId     String
  clockIn        DateTime
  clockOut       DateTime?
  autoClockedOut Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, clockIn])
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String?
  createdAt DateTime @default(now())
  recurring Boolean  @default(false)
}

model PromotionConfig {
  id           String   @id @default("default")
  wedThuActive Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  LIVE
}

enum Shift {
  NOON
  NIGHT
}

enum ReservationType {
  NORMAL
  GIFT
  VISIT
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CANCELLED
  PAYMENT_FAILED
}

enum EventStatus {
  OPEN
  FULL
  CLOSED
}

enum PaymentMethod {
  CASH
  CARD
}

enum EmailQueueStatus {
  PENDING
  SENT
  FAILED
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum CustomerType {
  PARTICULAR
  EMPRESA
}

model Space {
  id        String   @id @default(cuid())
  name      String   // Ej: "Sala Principal", "Terraza"
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])
  tables    Table[]
  createdAt DateTime @default(now())
}

model Table {
  id           String            @id @default(cuid())
  spaceId      String
  space        Space             @relation(fields: [spaceId], references: [id])
  identifier   String            // Ej: "Mesa 1", "Barra Columnas"
  type         TableType         @default(TABLE)
  shape        TableShape        @default(RECTANGLE)
  x            Float             // Posición para el mapa
  y            Float
  width        Float
  height       Float
  rotation     Float             @default(0)
  capacity     Int
  isFixed      Boolean           @default(false)
  assignments  TableAssignment[]
}

enum TableType {
  TABLE       // Mesas para sentarse
  DECORATIVE  // Como tu barra de cócteles fija
}

enum TableShape {
  RECTANGLE
  ROUND
  SQUARE
}

model TableAssignment {
  id            String      @id @default(cuid())
  tableId       String
  table         Table       @relation(fields: [tableId], references: [id])
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  eventId       String
  
  @@unique([tableId, reservationId, eventId])
}

model Setting {
  key   String @id
  value String
}

model BookingIntent {
  id            String              @id @default(cuid())
  name          String
  phone         String
  email         String
  allergies     String?
  previousVisit Boolean             @default(false)
  newsletter    Boolean             @default(false)
  comments      String?
  groupRef      String?
  isFirstVisit  Boolean             @default(true)
  date          DateTime
  shift         Shift
  guests        Int
  eventId       String?
  totalAmount   Decimal             @db.Decimal(10, 2)
  amountDue     Decimal             @db.Decimal(10, 2)
  payFull       Boolean             @default(false)
  orderId       String?             @unique
  status        BookingIntentStatus @default(AWAITING_PAYMENT)
  expiresAt     DateTime
  createdAt     DateTime            @default(now())

  @@index([status, expiresAt])
  @@index([orderId])
}

enum BookingIntentStatus {
  AWAITING_PAYMENT
  PAYMENT_FAILED
  COMPLETED
  EXPIRED
}

enum PaymentStatus {
  PARTIAL
  COMPLETED
  GIFT
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   // Admin user ID who performed the action
  action    String   // e.g., "DELETE_RESERVATION", "UPDATE_USER", "CHANGE_PASSWORD"
  table     String   // Table name: "Reservation", "User", "Campaign", etc.
  recordId  String   // ID of the affected record
  details   String?  // JSON: who changed what, from what to what
  ipAddress String?  // Source IP
  userAgent String?  // Browser/client info
  success   Boolean  @default(true)
  error     String?  // If action failed
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([table, createdAt])
}